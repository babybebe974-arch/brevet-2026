        {
          "nom": "Les classes grammaticales",
          "flashcards": [
            {"recto": "Quelles sont les 9 classes grammaticales ?", "verso": "Nom, déterminant, adjectif, pronom, verbe, adverbe, préposition, conjonction, interjection."},
            {"recto": "Donnez 3 exemples de déterminants.", "verso": "Définis : le, la, les ; indéfinis : un, une, des ; possessifs : mon, ton, son ; démonstratifs : ce, cet, cette."},
            {"recto": "Qu'est-ce qu'un pronom relatif ? Citez-en 3.", "verso": "Pronom qui introduit une proposition subordonnée relative : qui, que, quoi, dont, où, lequel."},
            {"recto": "Différence entre adverbe et préposition ?", "verso": "Adverbe modifie un verbe ou un adjectif (ex: rapidement, très). Préposition introduit un complément (ex: à, de, par, pour)."},
            {"recto": "Citez 4 conjonctions de coordination.", "verso": "Mais, ou, et, donc, or, ni, car."},
            {"recto": "Donnez 3 conjonctions de subordination.", "verso": "Que, lorsque, puisque, quoique, comme, si, quand."},
            {"recto": "À quoi reconnaît-on un nom ?", "verso": "On peut mettre un déterminant devant (le, un, mon). Ex: le chat, une table."},
            {"recto": "À quoi reconnaît-on un verbe ?", "verso": "On peut le conjuguer (changer de temps, de personne). Ex: je mange, tu mangais."}
          ]
        },
        {
          "nom": "Les fonctions grammaticales",
          "flashcards": [
            {"recto": "Qu'est-ce que le sujet ?", "verso": "La personne, l'animal ou la chose qui fait l'action ou qui est dans l'état exprimé par le verbe. Il commande l'accord du verbe."},
            {"recto": "Qu'est-ce que le COD ?", "verso": "Complément d'objet direct. Répond à la question 'qui ?' ou 'quoi ?' après le verbe. Ex: Je mange UNE POMME."},
            {"recto": "Qu'est-ce que le COI ?", "verso": "Complément d'objet indirect. Répond aux questions 'à qui ?', 'à quoi ?', 'de qui ?', 'de quoi ?'. Ex: Je parle À MARIE."},
            {"recto": "Qu'est-ce qu'un complément circonstanciel ?", "verso": "Complément qui donne des précisions sur les circonstances : temps, lieu, manière, cause, but. Ex: Il court LE MATIN (temps)."},
            {"recto": "Qu'est-ce que l'attribut du sujet ?", "verso": "Attribut qui donne une qualité ou une caractéristique au sujet, relié par un verbe d'état (être, paraître, sembler, devenir). Ex: Il est GRAND."},
            {"recto": "Qu'est-ce qu'une épithète ?", "verso": "Adjectif qui qualifie directement un nom, sans verbe. Ex: Une GRANDE maison."},
            {"recto": "Qu'est-ce qu'une apposition ?", "verso": "Nom ou adjectif placé à côté d'un autre nom pour le qualifier. Ex: Paris, CAPITALE DE LA FRANCE, est belle."},
            {"recto": "Qu'est-ce qu'un complément du nom ?", "verso": "Groupe de mots qui complète un nom. Ex: La maison DE MA GRAND-MÈRE."}
          ]
        },
        {
          "nom": "La phrase",
          "flashcards": [
            {"recto": "Quels sont les 4 types de phrases ?", "verso": "Déclarative, interrogative, exclamative, impérative."},
            {"recto": "Quelles sont les 2 formes de phrases ?", "verso": "Affirmative et négative."},
            {"recto": "Qu'est-ce qu'une phrase simple ?", "verso": "Une phrase qui contient une seule proposition (un seul verbe conjugué). Ex: Je mange."},
            {"recto": "Qu'est-ce qu'une phrase complexe ?", "verso": "Une phrase qui contient plusieurs propositions (plusieurs verbes conjugués). Ex: Je mange quand j'ai faim."},
            {"recto": "Qu'est-ce qu'une proposition indépendante ?", "verso": "Proposition qui ne dépend d'aucune autre. Ex: Je chante. Il pleut."},
            {"recto": "Qu'est-ce qu'une proposition principale ?", "verso": "Proposition dont dépend une subordonnée. Ex: Je pense QUE TU AS RAISON."},
            {"recto": "Qu'est-ce qu'une proposition subordonnée relative ?", "verso": "Proposition introduite par un pronom relatif (qui, que, dont, où). Ex: Le livre QUE JE LIS est intéressant."},
            {"recto": "Qu'est-ce qu'une proposition subordonnée conjonctive ?", "verso": "Proposition introduite par une conjonction de subordination (que, lorsque, puisque). Ex: Je veux QUE TU VIENNES."}
          ]
        },
        {
          "nom": "Les temps et modes verbaux",
          "flashcards": [
            {"recto": "Quels sont les 4 modes personnels ?", "verso": "Indicatif, subjonctif, conditionnel, impératif."},
            {"recto": "À quoi sert l'imparfait ?", "verso": "Décrire une action passée qui dure (description, habitude). Ex: Quand j'étais petit, je jouais au foot."},
            {"recto": "À quoi sert le passé simple ?", "verso": "Raconter une action passée, ponctuelle et achevée. Utilisé surtout à l'écrit. Ex: Il entra."},
            {"recto": "À quoi sert le passé composé ?", "verso": "Raconter une action passée, ponctuelle ou bilan. Utilisé à l'oral. Ex: J'ai mangé."},
            {"recto": "À quoi sert le plus-que-parfait ?", "verso": "Exprimer une action antérieure à une autre action passée. Ex: Il était déjà parti."},
            {"recto": "À quoi sert le futur simple ?", "verso": "Exprimer une action à venir. Ex: J'irai au cinéma."},
            {"recto": "À quoi sert le subjonctif ?", "verso": "Exprimer le doute, le souhait, l'émotion, l'obligation. Ex: Il faut que tu viennes."},
            {"recto": "À quoi sert le conditionnel ?", "verso": "Exprimer une action soumise à une condition (si...). Ex: Je voyagerais."}
          ]
        }
      ]
